{
  "redirects": [
    {
      "source": "/:path.html",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:server.js",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path",
      "destination": "/:path.html"
    }
  ]
}
