{
  "redirects": [
    {
      "source": "/index",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/homepage.html",
      "destination": "/homepage",
      "permanent": true
    },
    {
      "source": "/frontend/:path.html",
      "destination": "/frontend/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/homepage",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/:path",
      "destination": "/frontend/:path.html"
    }
  ]
}
