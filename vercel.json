{
  "redirects": [
    {
      "source": "/:path.html",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path",
      "destination": "/:path.html"
    },
    { 
      "source": "/api/server.js", 
      "destination": "/api/index.js" 
    }
  ]
}
